{
  "version": 2,
  "rewrites": [
    {
      "source": "/lulucaadmin",
      "destination": "/lulucaadmin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
